# Copy to .env. Never commit .env, passwords, JWTs or kubeconfig.
MLOPS_REPO=.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=iris-classification
AIRFLOW_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=agent
AIRFLOW_PASSWORD=
# Alternatively provide a short-lived JWT:
AIRFLOW_TOKEN=
AIRFLOW_DAG_ID=training_pipeline
KUBECONFIG=.local/kubeconfig
KUBE_NAMESPACE=mlops
KUBE_APP_SELECTOR=app=prediction-api
AGENT_API_TOKEN=
TOOL_TIMEOUT_SECONDS=15
# optional supported LLM tool calling, defaults to transparent deterministic planning
AGENT_PLANNER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=180
# Total LLM planning deadline, independent of per-service timeouts.
OLLAMA_MAX_SECONDS=600
OLLAMA_NUM_PREDICT=256
# Explicit policy, disabled if unset. Age alone is not degradation evidence.
MAX_MODEL_AGE_DAYS=
